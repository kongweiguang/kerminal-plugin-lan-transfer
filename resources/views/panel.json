{
  "schema": 1,
  "data": {
    "root_path": "",
    "shared_path": null,
    "selected_address": "",
    "address_options": [],
    "running": false,
    "starting": false,
    "stopping": false,
    "failed": false,
    "editable": true,
    "can_start": true,
    "can_stop": false,
    "address": null,
    "wildcard": false,
    "single_address": true,
    "active_ip": "",
    "active_ip_options": [],
    "link": null,
    "root_name": null,
    "qr": null,
    "status": "",
    "error": null,
    "show_error": false,
    "stats": "",
    "copy_label": "Copy link"
  },
  "root": {
    "type": "scroll",
    "x-kerminal-appearance": "inset",
    "x-kerminal-action-error": "$error",
    "child": {
      "type": "stack",
      "gap": "md",
      "children": [
        {
          "type": "row",
          "x-kerminal-appearance": "header",
          "gap": "sm",
          "children": [
            {
              "type": "text",
              "x-kerminal-appearance": "title",
              "text": "%tool.title%"
            },
            {
              "type": "button",
              "action": "start",
              "x-kerminal-requires-text": "$root_path",
              "label": "%action.start%",
              "icon": "play",
              "variant": "primary",
              "busy": "$starting",
              "visible": "$can_start"
            },
            {
              "type": "button",
              "action": "stop",
              "label": "%action.stop%",
              "icon": "circle-stop",
              "variant": "ghost",
              "busy": "$stopping",
              "visible": "$can_stop"
            }
          ]
        },
        {
          "type": "section",
          "title": "",
          "x-kerminal-appearance": "grouped",
          "gap": "md",
          "visible": "$editable",
          "children": [
            {
              "type": "path",
              "bind": "root_path",
              "label": "%field.folder%",
              "mode": "directory"
            },
            {
              "type": "input",
              "bind": "selected_address",
              "label": "%field.address%",
              "placeholder": "%placeholder.address%",
              "on_submit": "set-address",
              "x-kerminal-select-options": "$address_options"
            }
          ]
        },
        {
          "type": "section",
          "title": "",
          "x-kerminal-appearance": "grouped",
          "gap": "md",
          "visible": "$running",
          "children": [
            {
              "type": "stack",
              "gap": "sm",
              "children": [
                {
                  "type": "text",
                  "x-kerminal-appearance": "caption",
                  "text": "%field.folder%",
                  "tone": "muted"
                },
                {
                  "type": "text",
                  "x-kerminal-appearance": "value",
                  "text": "$shared_path"
                }
              ]
            },
            {
              "type": "stack",
              "gap": "sm",
              "children": [
                {
                  "type": "text",
                  "x-kerminal-appearance": "caption",
                  "text": "%field.address%",
                  "tone": "muted"
                },
                {
                  "type": "row",
                  "x-kerminal-appearance": "stretch-first",
                  "gap": "sm",
                  "visible": "$wildcard",
                  "children": [
                    {
                      "type": "input",
                      "bind": "active_ip",
                      "on_submit": "select-active-ip",
                      "x-kerminal-select-options": "$active_ip_options",
                      "x-kerminal-on-change": "select-active-ip"
                    },
                    {
                      "type": "button",
                      "action": "copy-link",
                      "label": "$copy_label",
                      "icon": "copy",
                      "variant": "secondary"
                    }
                  ]
                },
                {
                  "type": "row",
                  "x-kerminal-appearance": "stretch-first",
                  "gap": "sm",
                  "visible": "$single_address",
                  "children": [
                    {
                      "type": "text",
                      "x-kerminal-appearance": "mono",
                      "text": "$address"
                    },
                    {
                      "type": "button",
                      "action": "copy-link",
                      "label": "$copy_label",
                      "icon": "copy",
                      "variant": "secondary"
                    }
                  ]
                }
              ]
            },
            {
              "type": "qrcode",
              "matrix": "$qr"
            },
            {
              "type": "text",
              "x-kerminal-appearance": "caption",
              "text": "$stats",
              "tone": "muted"
            }
          ]
        },
        {
          "type": "text",
          "text": "$error",
          "tone": "danger",
          "visible": "$show_error"
        }
      ]
    }
  }
}
