{
  "schema": 1,
  "data": {
    "root_path": "",
    "shared_path": null,
    "selected_address": "",
    "addresses_hint": "127.0.0.1 is local only",
    "running": false,
    "starting": false,
    "stopping": false,
    "failed": false,
    "editable": true,
    "can_start": true,
    "can_stop": false,
    "address": null,
    "scope": "",
    "link": null,
    "root_name": null,
    "qr": null,
    "status": "",
    "error": null,
    "show_error": false,
    "stats": "",
    "copy_label": "Copy link"
  },
  "root": {
    "type": "scroll",
    "x-kerminal-appearance": "inset",
    "x-kerminal-action-error": "$error",
    "child": {
      "type": "stack",
      "gap": "md",
      "children": [
        {
          "type": "row",
          "x-kerminal-appearance": "header",
          "gap": "sm",
          "children": [
            {
              "type": "stack",
              "gap": "sm",
              "children": [
                {
                  "type": "text",
                  "x-kerminal-appearance": "title",
                  "text": "%tool.title%"
                },
                {
                  "type": "badge",
                  "x-kerminal-appearance": "caption",
                  "text": "$status",
                  "tone": "default"
                }
              ]
            },
            {
              "type": "button",
              "action": "start",
              "x-kerminal-requires-text": "$root_path",
              "label": "%action.start%",
              "icon": "play",
              "variant": "primary",
              "busy": "$starting",
              "visible": "$can_start"
            },
            {
              "type": "button",
              "action": "stop",
              "label": "%action.stop%",
              "icon": "circle-stop",
              "variant": "ghost",
              "busy": "$stopping",
              "visible": "$can_stop"
            }
          ]
        },
        {
          "type": "section",
          "title": "%section.share%",
          "x-kerminal-appearance": "grouped",
          "gap": "sm",
          "visible": "$editable",
          "children": [
            {
              "type": "path",
              "bind": "root_path",
              "label": "%field.folder%",
              "mode": "directory"
            },
            {
              "type": "input",
              "bind": "selected_address",
              "label": "%field.address%",
              "placeholder": "%placeholder.address%",
              "on_submit": "set-address"
            },
            {
              "type": "text",
              "x-kerminal-appearance": "caption",
              "text": "$addresses_hint",
              "tone": "muted"
            }
          ]
        },
        {
          "type": "section",
          "title": "$root_name",
          "x-kerminal-appearance": "grouped",
          "gap": "sm",
          "visible": "$running",
          "children": [
            {
              "type": "text",
              "text": "$shared_path"
            },
            {
              "type": "text",
              "x-kerminal-appearance": "caption",
              "text": "%field.address%",
              "tone": "muted"
            },
            {
              "type": "text",
              "text": "$address"
            },
            {
              "type": "text",
              "x-kerminal-appearance": "caption",
              "text": "$scope",
              "tone": "muted"
            },
            {
              "type": "button",
              "action": "copy-link",
              "label": "$copy_label",
              "icon": "copy",
              "variant": "secondary"
            },
            {
              "type": "qrcode",
              "matrix": "$qr"
            },
            {
              "type": "text",
              "x-kerminal-appearance": "caption",
              "text": "$stats",
              "tone": "muted"
            }
          ]
        },
        {
          "type": "text",
          "text": "$error",
          "tone": "danger",
          "visible": "$show_error"
        },
        {
          "type": "notice",
          "x-kerminal-appearance": "caption",
          "text": "%notice.plaintext%",
          "tone": "warning"
        }
      ]
    }
  }
}
